# Additions to Buildroot's board/qemu/x86_64/linux.config
# 9p shared folder (optional quick file exchange with the host)
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
# Better debugging of our drivers
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y
# Message Signaled Interrupts (needed by custom-pci-device)
CONFIG_PCI_MSI=y
